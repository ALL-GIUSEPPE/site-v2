    /* ... (keep your previous styles) ... */

    .lens-container {
        position: relative;
        width: 80vw;
        max-width: 500px;
        aspect-ratio: 1/1;
        border-radius: 50%;
        overflow: hidden;
        cursor: pointer;
        z-index: 10;
        transition: all 1.2s cubic-bezier(0.85, 0, 0.15, 1);
        
        /* Remove the box-shadow from here, we move it to the pseudo-element */
    }

    /* THE VIRTUAL LENS LAYER */
    .lens-container::after {  
        content: " ";  /* mogelijke titel toevoegen voor video */
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        border-radius: inherit; /* Keeps it a circle */
        
        /* The shadow is now on top of the video */
        box-shadow: 
            inset 0 0 180px rgb(1, 1, 82), 
            inset 0 0 180px rgb(0, 0, 0);
            
        /* Crucial: lets you click the video underneath */
        pointer-events: none; 
        z-index: 20; /* Higher than the video-wrapper */
        transition: opacity 9.5s ease;
    }

    /* Hide the shadow overlay when zoomed in */
    .zoomed-in .lens-container::after {
        opacity: 0;
    }

    .video-wrapper {
        width: 100%;
        height: 100%;
        transition: transform 1.2s ease;
        transform: scale(6.0); /* Tweak this to zoom the initial frame */
        z-index: 5; /* Lower than the ::after layer */
    }

    


        /* The actual video player */
        iframe {
            width: 230%; /* Oversized to create the "zoom" look inside the circle */
            height: 170%;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            pointer-events: none; /* Prevents interaction until fullscreen */
            transition: all 1s ease-in-out;

            box-shadow: 
                inset 0 0 80px rgba(0, 0, 0, 1), 
                inset 0 0 30px rgba(0, 50, 255, 0.6);
        }
        

        /* --- ANIMATION STATES --- */
        .zoomed-in .lens-container {
            width: 100vw;
            max-width: none;
            height: 100vh;
            border-radius: 0%;
           
           
        }

        

        .zoomed-in iframe {
            width: 100%;
            height: 100%;
