    <script src="https://player.vimeo.com/api/player.js"></script>
    <script>
        // Menu Toggle
        const menuBtn = document.getElementById('menuBtn');
        const menuOverlay = document.getElementById('menuOverlay');
        menuBtn.onclick = () => {
            menuBtn.classList.toggle('open');
            menuOverlay.classList.toggle('active');
        };

        // Fisheye Zoom Logic
        const lens = document.getElementById('lens');
        const videoSection = document.getElementById('videoSection');
        const pressPlay = document.getElementById('pressPlay');
        const iframe = document.getElementById('vimeoPlayer');
        const player = new Vimeo.Player(iframe);

        let isZoomed = false;

        lens.onclick = function() {
            if (!isZoomed) {
                // Zoom In
                videoSection.classList.add('zoomed-in');
                pressPlay.classList.add('hidden');
                player.play();
                isZoomed = true;
            }
        };

        // Detect when video ends to reverse animation
        player.on('ended', function() {
            videoSection.classList.remove('zoomed-in');
            pressPlay.classList.remove('hidden');
            isZoomed = false;
        });
    </script>
